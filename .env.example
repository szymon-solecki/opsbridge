# Local-development placeholders only; these are not production credentials.
APP_ENV=local
APP_LOG_LEVEL=INFO

# Local PostgreSQL connection (service will be introduced in phase 2).
POSTGRES_DB=opsbridge
POSTGRES_USER=opsbridge
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://opsbridge:change-me-local-only@localhost:5432/opsbridge

# Local RabbitMQ application account (service will be introduced in phase 5).
# These values are local placeholders, not production credentials.
RABBITMQ_DEFAULT_USER=opsbridge
RABBITMQ_DEFAULT_PASS=change-me-local-only
RABBITMQ_URL=amqp://opsbridge:change-me-local-only@localhost:5672/

# Local SFTP endpoint. SFTP_PORT is the loopback-bound host port used by Compose.
SFTP_HOST=localhost
SFTP_PORT=2222
SFTP_USERNAME=opsbridge-local
# Local account map mounted read-only at /run/config/sftp-accounts.json.
SFTP_ACCOUNTS_FILE=./.secrets/sftp-accounts.json
# Authorized public keys are stored in each account's `authorized_key` field
# inside SFTP_ACCOUNTS_FILE; the server has no separate authorized-keys source path.
# Host-run simulator's private client key; keep it under the ignored .secrets/ directory.
SFTP_PRIVATE_KEY_PATH=./.secrets/sftp_id_ed25519
